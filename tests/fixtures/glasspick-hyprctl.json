{
  "program": [
    "#!/usr/bin/env python3",
    "# Fake compositor transport; typed functions and their argument checks stay real.",
    "import json",
    "import os",
    "from pathlib import Path",
    "import re",
    "import sys",
    "",
    "root = Path(os.environ['GLASSPICK_HYPR_ROOT'])",
    "args = sys.argv[1:]",
    "capture_pid = int((root / 'capture-pid').read_text())",
    "focus_pid = int((root / 'focus-pid').read_text())",
    "if args == ['activewindow', '-j']:",
    "    print(json.dumps({'address': hex(focus_pid), 'class': 'com.thisisgm.flea', 'pid': focus_pid}))",
    "elif args == ['clients', '-j']:",
    "    print(json.dumps([{'address': hex(capture_pid), 'class': 'com.thisisgm.flea', 'pid': capture_pid},",
    "                     {'address': '0xb', 'class': 'com.thisisgm.flea.glasspick.backdrop', 'pid': 11},",
    "                     {'address': '0xc', 'class': 'com.thisisgm.flea.glasspick.terminal', 'pid': 12},",
    "                     {'address': '0x64', 'class': 'replay.caller', 'pid': 100}]))",
    "elif args == ['-j', 'getoption', 'decoration:blur:enabled']:",
    "    print('{\"bool\":true}')",
    "elif len(args) == 2 and args[0] == 'dispatch':",
    "    command = args[1]",
    "    # Sample input: hl.dsp.focus({ window = \"address:0xabc\" })",
    "    patterns = (",
    "        r'hl\\.dsp\\.focus\\(\\{ window = \"address:(0x[0-9a-fA-F]+)\" \\}\\)',",
    "        r'hl\\.dsp\\.window\\.float\\(\\{ action = \"(?:on|off)\", window = \"address:0x[0-9a-fA-F]+\" \\}\\)',",
    "        r'hl\\.dsp\\.window\\.resize\\(\\{ x = [0-9]+, y = [0-9]+, exact = true, window = \"address:0x[0-9a-fA-F]+\" \\}\\)',",
    "        r'hl\\.dsp\\.window\\.set_prop\\(\\{window = \"address:0x[0-9a-fA-F]+\", prop = \"(?:opacity|opacity_inactive|opacity_override|opacity_inactive_override)\", value = \"(?:1|0\\.[0-9]+)\"\\}\\)',",
    "    )",
    "    matches = [re.fullmatch(pattern, command) for pattern in patterns]",
    "    if not any(matches):",
    "        raise SystemExit('unexpected compositor write: ' + command)",
    "    with (root / 'writes').open('a') as log:",
    "        log.write(command + '\\n')",
    "    status = int(os.environ.get('GLASSPICK_HYPR_STATUS', '0'))",
    "    reply = os.environ.get('GLASSPICK_HYPR_REPLY', 'ok')",
    "    if status == 0 and reply == 'ok' and matches[0]:",
    "        address = matches[0][1]",
    "        (root / 'focus-pid').write_text(str(int(address, 16)) + '\\n')",
    "        with (root / 'focus').open('a') as log:",
    "            log.write(address + '\\n')",
    "    print(reply)",
    "    sys.exit(status)",
    "else:",
    "    raise SystemExit('unexpected compositor request: ' + repr(args))"
  ]
}
